{
  "name": "@cluvix/livechat-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Cluvix livechat embeddable widget (vanilla TS, độc lập với app Angular chính).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cluvix/cluvix-livechat-widget.git"
  },
  "bugs": {
    "url": "https://github.com/cluvix/cluvix-livechat-widget/issues"
  },
  "homepage": "https://github.com/cluvix/cluvix-livechat-widget#readme",
  "files": [
    "dist",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "build:loader": "vite build --config vite.loader.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "build:widget": "npm run type-check && npm run build:loader && npm run build:app",
    "build": "npm run build:widget",
    "dev": "vite ./dev --port 5500 --strictPort",
    "size": "node scripts/size.mjs",
    "test": "playwright test",
    "check-changelog": "node scripts/check-changelog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
